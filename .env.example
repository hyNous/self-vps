# Required. DNS A/AAAA record must already point to this VPS.
NODE_DOMAIN=node.example.com
ACME_EMAIL=admin@example.com

# SSH port that must remain reachable when UFW is enabled.
SSH_PORT=22

# Reality target. Keep the IP form when the hostname resolves to multiple
# Cloudflare addresses; serverNames must match a certificate served by dest.
REALITY_DEST=104.16.123.96:443
REALITY_SERVER_NAME=www.cloudflare.com

# Optional. Leave empty to generate on first install.
# The values are stored in /etc/self-vps/reality.env (mode 600).
REALITY_UUID=
REALITY_SHORT_ID=

# Optional. Leave empty to generate a VLESS/WS CDN fallback.
# CDN_DOMAIN defaults to cdn.<zone> derived from NODE_DOMAIN.
CDN_DOMAIN=
VLESS_UUID=
VLESS_WS_PATH=

# Set to 1 only after key-based SSH login is verified.
ENABLE_SSH_HARDENING=0
