# Required. DNS A/AAAA record must already point to this VPS.
NODE_DOMAIN=node.example.com
ACME_EMAIL=admin@example.com

# SSH port that must remain reachable when UFW is enabled.
SSH_PORT=22

# Optional. Leave empty to generate a 48-character hexadecimal password.
TROJAN_PASSWORD=

# Optional. CDN hostname for the VLESS+WS fallback entry.
# Leave empty to derive cdn.<zone> from NODE_DOMAIN:
# node.example.com -> cdn.example.com
CDN_DOMAIN=

# Optional. Leave empty to generate.
VLESS_UUID=
VLESS_WS_PATH=

# Set to 1 only after key-based SSH login is verified.
# Installs key-only SSH hardening and disables password/root SSH.
ENABLE_SSH_HARDENING=0
